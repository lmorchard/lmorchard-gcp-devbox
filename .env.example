# GCP Configuration
PROJECT_ID=
ZONE=us-central1-a
NETWORK=
SUBNET=
INSTANCE_NAME=wideboi-sandbox
MACHINE_TYPE=e2-standard-4
BOOT_DISK_SIZE=50GB
BOOT_DISK_TYPE=pd-balanced
# Image Configuration (defaults to auto-detecting pre-baked 'devbox-base' family; falls back to stock Ubuntu)
# Set USE_CUSTOM_IMAGE=false to force stock Ubuntu
# IMAGE_FAMILY=ubuntu-2404-lts-amd64
# IMAGE_PROJECT=ubuntu-os-cloud
# USE_CUSTOM_IMAGE=true

# Target user & Tailscale
DEV_USER=lmorchard
TAILSCALE_HOSTNAME=wideboi-sandbox
# Path to local SSH public key to install on devbox (defaults to ~/.ssh/id_ed25519.pub or ~/.ssh/id_rsa.pub)
SSH_PUBKEY_PATH=

# Wideboi Web Token (fixed token for web UI authentication)
WIDEBOI_TOKEN=

# Idle Auto-Stop Timeout (hours of inactivity before powering off to save costs; 0 to disable)
AUTO_STOP_HOURS=2

# Service Account Name
SA_NAME=devbox-runner

# ------------------------------------------------------------------------------
# Secrets (uploaded to GCP Secret Manager via 'make init-secrets')
# ------------------------------------------------------------------------------
# Tailscale auth key (reusable or ephemeral)
TAILSCALE_AUTH_KEY=

# GitHub Personal Access Token (PAT) with repo/workflow scope
GITHUB_PAT=

# Path to Claude credentials JSON (defaults to ~/.claude/.credentials.json if empty)
CLAUDE_CREDS_PATH=

# Agent API Keys (optional fallbacks)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Vertex AI for Opencode (optional)
# Path to local service account key json (defaults to ~/.config/opencode/vertex-sa-key.json)
VERTEX_SA_KEY_PATH=
# Project & location for Vertex
VERTEX_PROJECT_ID=my-vertex-project-id
VERTEX_LOCATION=global
